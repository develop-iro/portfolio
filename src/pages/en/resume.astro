---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResumePage from '../../features/resume/ResumePage.astro';
import { useTranslations } from '../../shared/i18n/translations';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout
  title="Resume - Ivan Romero"
  description="Resume of Ivan Romero, Senior Frontend Developer specialising in React, TypeScript, frontend architecture, testing, accessibility, and AI-assisted migrations."
  lang={lang}
  alternates={[
    { hreflang: 'en', href: 'https://ivan-romero.dev/en/resume' },
    { hreflang: 'es', href: 'https://ivan-romero.dev/es/resume' },
  ]}
>
  <ResumePage lang={lang} t={t} />
</BaseLayout>
