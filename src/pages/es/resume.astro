---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResumePage from '../../features/resume/ResumePage.astro';
import { useTranslations } from '../../shared/i18n/translations';

const lang = 'es' as const;
const t = useTranslations(lang);
---

<BaseLayout
  title="Curriculum - Ivan Romero"
  description="Curriculum de Ivan Romero, Senior Frontend Developer especializado en React, TypeScript, arquitectura frontend, testing, accesibilidad y migraciones asistidas por IA."
  lang={lang}
  alternates={[
    { hreflang: 'en', href: 'https://ivan-romero.dev/en/resume' },
    { hreflang: 'es', href: 'https://ivan-romero.dev/es/resume' },
  ]}
>
  <ResumePage lang={lang} t={t} />
</BaseLayout>
